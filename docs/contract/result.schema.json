{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Raaif-Yousuf/DNA-Entropy-Graph/main/docs/contract/result.schema.json",
  "type": "object",
  "title": "JobResult (result.json)",
  "properties": {
    "schema": {
      "type": "integer"
    },
    "jobId": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "InputResult",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": [
              "object",
              "null"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "title": "ResultFile",
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "bytes": {
                  "type": "integer"
                }
              },
              "required": [
                "path",
                "sha256",
                "bytes"
              ]
            }
          },
          "notices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stats": {
            "type": [
              "object",
              "null"
            ],
            "title": "ResultStats",
            "properties": {
              "contigs": {
                "type": "integer"
              },
              "totalNt": {
                "type": "integer"
              },
              "meanEntropy": {
                "type": "number"
              },
              "minEntropy": {
                "type": "number"
              },
              "maxEntropy": {
                "type": "number"
              }
            },
            "required": [
              "contigs",
              "totalNt",
              "meanEntropy",
              "minEntropy",
              "maxEntropy"
            ]
          }
        },
        "required": [
          "id",
          "status"
        ]
      }
    },
    "timing": {
      "type": "object",
      "title": "ResultTiming",
      "properties": {
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        }
      },
      "required": [
        "startedAt",
        "finishedAt"
      ]
    },
    "gpu": {
      "type": "object",
      "title": "ResultGpu",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "zone": {
          "type": [
            "string",
            "null"
          ]
        },
        "spot": {
          "type": "boolean"
        }
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "jobId",
    "status",
    "inputs",
    "timing"
  ]
}
