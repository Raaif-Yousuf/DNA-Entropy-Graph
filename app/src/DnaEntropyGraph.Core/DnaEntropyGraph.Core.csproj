<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hard Rule 7: only DnaEntropyGraph.Cloud may reference Google.*. This
    project must never gain a PackageReference to any Google.* or torch/onnx
    package (Hard Rule 6) - Guards.Tests's csproj scan (issue #68) enforces
    this mechanically once it exists; until then, this comment and the
    dependency-arrow diagram in docs/architecture.md are the contract.
  -->
  <PropertyGroup>
    <AssemblyName>DnaEntropyGraph.Core</AssemblyName>
    <RootNamespace>DnaEntropyGraph.Core</RootNamespace>
  </PropertyGroup>

  <!-- Issue #261: worker/vm/startup.sh is the single source of the VM startup
       script; StartupMetadata attaches this exact text as the startup-script
       metadata value. -->
  <ItemGroup>
    <EmbeddedResource Include="../../../worker/vm/startup.sh" LogicalName="startup.sh" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DnaEntropyGraph.Cloud.Tests" />
  </ItemGroup>

</Project>
