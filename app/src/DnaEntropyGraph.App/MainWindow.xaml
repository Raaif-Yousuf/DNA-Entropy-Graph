<Window
    x:Class="DnaEntropyGraph.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DnaEntropyGraph.App.Converters">

    <!--
        ExtendsContentIntoTitleBar and SystemBackdrop are set in
        MainWindow.xaml.cs, not here, as plain one-line property
        assignments, and the active-run badge below calls
        converters:VisibilityHelper.FromBool directly rather than going
        through an IValueConverter declared in a resource dictionary.
        MEASURED 2026-09-19: both `ExtendsContentIntoTitleBar="True"` as a
        XAML attribute, and a `Window.Resources` entry instantiating a
        custom IValueConverter, independently crash this Windows App SDK
        version's XamlCompiler.exe with no diagnostic output at all -
        each reproduced in isolation on an otherwise-empty Window. Filed as
        an issue; see this session's report.
    -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The extended, draggable title bar (issue #62): app name on the left, the status pill on the right. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="ShellTitle"
                Grid.Column="0"
                VerticalAlignment="Center"
                Margin="16,0,0,0" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Margin="0,0,16,0"
                Text="{x:Bind ViewModel.StatusPillText, Mode=OneWay}" />
        </Grid>

        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="True"
            Header="{x:Bind ViewModel.CurrentPageKey, Mode=OneWay}"
            SelectionChanged="RootNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavNewRun" Tag="NewRun">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavRuns" Tag="Runs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Visibility="{x:Bind converters:VisibilityHelper.FromBool(ViewModel.HasActiveRun), Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavCloud" Tag="Cloud">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavSettings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="RootFrame" x:FieldModifier="public" />
        </NavigationView>
    </Grid>
</Window>
