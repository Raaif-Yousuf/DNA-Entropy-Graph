<Window
    x:Class="DnaEntropyGraph.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DnaEntropyGraph.App.Converters">

    <!--
        ExtendsContentIntoTitleBar and SystemBackdrop are set in
        MainWindow.xaml.cs, not here, as plain one-line property
        assignments, and the active-run badge below calls
        converters:VisibilityHelper.FromBool directly rather than going
        through an IValueConverter declared in a resource dictionary.
        MEASURED 2026-09-19: both `ExtendsContentIntoTitleBar="True"` as a
        XAML attribute, and a `Window.Resources` entry instantiating a
        custom IValueConverter, independently crash this Windows App SDK
        version's XamlCompiler.exe with no diagnostic output at all -
        each reproduced in isolation on an otherwise-empty Window. Filed as
        an issue; see this session's report.
    -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The extended, draggable title bar (issue #62): app name on the left, the status pill on the right. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock x:Uid="ShellTitle" VerticalAlignment="Center" />
                <!-- Issue #638: a sandboxed data folder (the profile switch or DEG_DATA_DIR) is named here, so it cannot be mistaken for the real profile. -->
                <Border
                    Visibility="{x:Bind converters:VisibilityHelper.FromBool(ViewModel.HasProfileOverride)}"
                    Margin="12,0,0,0"
                    Padding="8,2"
                    CornerRadius="4"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                    <TextBlock Text="{x:Bind ViewModel.ProfileBannerText}" TextTrimming="CharacterEllipsis" />
                </Border>
            </StackPanel>
            <!--
                MEASURED 2026-09-20: with a 16 DIP right margin the status pill
                sat directly underneath the minimise, maximise and close
                buttons, which the system draws on top of an
                ExtendsContentIntoTitleBar window and which this app does not
                own. "Not signed in" and the close button overlapped on screen.
                The three caption buttons are 46 DIP wide each, so 154 clears
                them with a 16 DIP gap, in DIPs so it holds at any scale.
            -->
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Margin="0,0,154,0"
                Text="{x:Bind ViewModel.StatusPillText, Mode=OneWay}" />
        </Grid>

        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="True"
            Header="{x:Bind ViewModel.CurrentPageTitle, Mode=OneWay}"
            SelectionChanged="RootNavigationView_SelectionChanged"
            Loaded="RootNavigationView_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavNewRun" Tag="NewRun">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavRuns" Tag="Runs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Visibility="{x:Bind converters:VisibilityHelper.FromBool(ViewModel.HasActiveRun), Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavCloud" Tag="Cloud">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavSettings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="RootFrame" x:FieldModifier="public" />
        </NavigationView>

        <!--
            Issue #585: the in-app message bar behind IToastService. One message at a time, floating over the
            page at the bottom; info and success close themselves, errors stay until the user closes the bar.
            IsOpen is TwoWay so the close button clears the ViewModel state too.
        -->
        <InfoBar
            x:Name="MessageBar"
            Grid.Row="1"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            MaxWidth="640"
            Margin="16"
            IsClosable="True"
            Title="{x:Bind ViewModel.Messages.Title, Mode=OneWay}"
            Message="{x:Bind ViewModel.Messages.Message, Mode=OneWay}"
            Severity="{x:Bind converters:InfoBarSeverityHelper.From(ViewModel.Messages.Severity), Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.Messages.IsOpen, Mode=TwoWay}" />
    </Grid>
</Window>
