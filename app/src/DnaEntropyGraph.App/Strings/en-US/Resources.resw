    <value>Billing</value>
  </data>
  <data name="WizardStep_Billing_Why" xml:space="preserve">
    <value>Google charges for the rented GPU, so the project needs a billing account. You pay only for the minutes a run uses, about $0.10 to $0.50 for a typical run.</value>
  </data>
