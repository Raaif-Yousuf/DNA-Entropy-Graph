  <data name="WizardTitle.Text" xml:space="preserve">
    <value>Set up Google Cloud</value>
  </data>
  <data name="WizardWelcome.Text" xml:space="preserve">
    <value>DNA Entropy Graph runs on a graphics card (a GPU) that you rent by the minute in your own Google Cloud account. A typical run takes 5 to 20 minutes and costs about $0.10 to $0.50. This page connects your account and checks each thing the app needs. When a step shows Fix, press its button, or choose Do it by hand.</value>
  </data>
