<Page
    x:Class="DnaEntropyGraph.App.Views.NewRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DnaEntropyGraph.Presentation.ViewModels">

    <!--
        Issue #63: the page a biologist uses every day. Every value is x:Bind (compile-time checked, so a
        renamed property is a build error, not a blank label) against NewRunViewModel. Code-behind only
        forwards the drop to the view model (Hard Rule 8). The drop command is deliberately not named here:
        the wiring guard reads XAML text, and a comment naming a command would hide it from the allowlist check.
    -->
    <ScrollViewer>
        <!-- Issue #110: Ctrl+Shift+V puts the clipboard in the Paste sequence box (Appendix A section 6). -->
        <ScrollViewer.KeyboardAccelerators>
            <KeyboardAccelerator Key="V" Modifiers="Control,Shift" Invoked="{x:Bind ViewModel.PasteFromClipboard}" />
        </ScrollViewer.KeyboardAccelerators>
        <StackPanel Padding="24" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False" />

            <Border
                x:Name="DropZone"
                AllowDrop="True"
                Padding="24"
                CornerRadius="8"
                BorderThickness="2"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock
                        x:Uid="NewRunDropTitle"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        x:Uid="NewRunDropHint"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        x:Uid="NewRunAddFiles"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.BrowseCommand}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </Border>

            <Expander x:Uid="NewRunPasteExpander" IsExpanded="{x:Bind ViewModel.IsPasteOpen, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBox
                        x:Uid="NewRunPasteBox"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="100"
                        FontFamily="Consolas"
                        Text="{x:Bind ViewModel.PasteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Uid="NewRunPasteAdd" Command="{x:Bind ViewModel.AddPastedCommand}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.PasteCountText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <ListView
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:InputPillItem">
                        <StackPanel Padding="0,8" Spacing="2" AutomationProperties.Name="{x:Bind DisplayName}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind KindText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind SummaryText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Uid="NewRunPillChecking"
                                    Visibility="{x:Bind IsChecking, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind ErrorText, Mode=OneWay}"
                                Visibility="{x:Bind HasError, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock
                                Text="{x:Bind NoticesText, Mode=OneWay}"
                                Visibility="{x:Bind HasNotices, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Text="{x:Bind AnnotationText, Mode=OneWay}"
                                Visibility="{x:Bind HasAnnotation, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind AnnotationNoticesText, Mode=OneWay}"
                                Visibility="{x:Bind HasAnnotationNotices, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Uid="NewRunRemoveItem"
                    Command="{x:Bind ViewModel.RemoveItemCommand}"
                    CommandParameter="{x:Bind ViewModel.SelectedItem, Mode=OneWay}" />
                <Button
                    x:Uid="NewRunTreatAsRna"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.OfferTreatAsRna, Mode=OneWay}"
                    Command="{x:Bind ViewModel.TreatAsRnaCommand}" />
                <TextBlock
                    x:Uid="NewRunRnaTreatedNote"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsTreatingAsRna, Mode=OneWay}" />
                <Button
                    x:Uid="NewRunStopTreatAsRna"
                    Visibility="{x:Bind ViewModel.IsTreatingAsRna, Mode=OneWay}"
                    Command="{x:Bind ViewModel.StopTreatingAsRnaCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.OffersAnnotation}">
                <Button x:Uid="NewRunAddGff3" Command="{x:Bind ViewModel.AddAnnotationCommand}" />
                <Button x:Uid="NewRunRemoveGff3" Command="{x:Bind ViewModel.RemoveAnnotationCommand}" CommandParameter="{x:Bind ViewModel.SelectedItem, Mode=OneWay}" />
            </StackPanel>

            <TextBlock
                x:Uid="NewRunRunsSelectedOnly"
                Visibility="{x:Bind ViewModel.HasSeveralItems, Mode=OneWay}"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock
                Text="{x:Bind ViewModel.EstimateText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasEstimate, Mode=OneWay}"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock
                Text="{x:Bind ViewModel.EstimateDiskText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasEstimateDisk, Mode=OneWay}"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Issue #136: option presets. The summary line under the picker lists what the next run will use. -->
            <Expander x:Uid="NewRunPresetExpander" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <ComboBox
                        x:Uid="NewRunPresetCombo"
                        ItemsSource="{x:Bind ViewModel.Presets.Items}"
                        SelectedItem="{x:Bind ViewModel.Presets.SelectedItem, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName"
                        MinWidth="260" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Presets.DetailText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Presets.HasDetail, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Presets.SummaryText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            x:Uid="NewRunPresetNameBox"
                            MinWidth="220"
                            Text="{x:Bind ViewModel.Presets.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Uid="NewRunPresetSave" Command="{x:Bind ViewModel.Presets.SaveCurrentCommand}" />
                        <Button x:Uid="NewRunPresetDelete" Command="{x:Bind ViewModel.Presets.DeleteCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="NewRunPresetCopy" Command="{x:Bind ViewModel.Presets.CopyMineCommand}" />
                        <Button x:Uid="NewRunPresetAdd" Command="{x:Bind ViewModel.Presets.AddFromClipboardCommand}" />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.Presets.StatusText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasOutputChoices, Mode=OneWay}">
                <TextBlock
                    x:Uid="NewRunOutputsHeader"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.OutputChoices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OutputChoiceItem">
                            <CheckBox
                                Content="{x:Bind Label}"
                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Uid="NewRunOutputsNoneChosen"
                    Visibility="{x:Bind ViewModel.HasNoOutputChosen, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <Button
                x:Uid="NewRunRun"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.StartRunCommand}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
