<Page
    x:Class="DnaEntropyGraph.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DnaEntropyGraph.App.Converters"
    xmlns:vm="using:DnaEntropyGraph.Presentation.ViewModels">

    <!--
        Titled groups (docs/ui_conventions.md section 10): a header, then a card holding that group's controls. The page has
        no title of its own: the shell's NavigationView header already says "Settings" (#627). Issue #104's other groups
        (#640 to #644) add one more group StackPanel each, in the order the user_guide lists them. Every string is in
        Resources.resw via x:Uid.
    -->
    <Page.Resources>
        <Style x:Key="SettingsGroupCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsAppearanceHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsGroupCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SettingsAppearanceExplainer" TextWrapping="Wrap" />
                        <!-- One selection source: click, arrow keys and touch all change SelectedIndex, which the view model applies and saves. -->
                        <RadioButtons x:Uid="ThemeChoices" MaxColumns="3" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <RadioButton x:Uid="ThemeLightRadio" />
                            <RadioButton x:Uid="ThemeDarkRadio" />
                            <RadioButton x:Uid="ThemeSystemRadio" />
                        </RadioButtons>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsRunDefaultsHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsGroupCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SettingsRunDefaultsExplainer" TextWrapping="Wrap" />
                        <TextBlock x:Uid="SettingsRunDefaultsGenBankHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind RunDefaults.GenBankChoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OutputChoiceItem">
                                    <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind RunDefaults.GenBankStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Uid="SettingsRunDefaultsSequenceHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind RunDefaults.SequenceChoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OutputChoiceItem">
                                    <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind RunDefaults.SequenceStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsFilesHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsGroupCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SettingsFilesExplainer" TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="FilesDataLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Files.DataFolderPath}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            <Button x:Uid="FilesDataOpenButton" Command="{x:Bind Files.OpenDataFolderCommand}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="FilesInputsLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Files.InputsFolderPath}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            <TextBlock x:Uid="FilesInputsSizeLabel" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Files.InputsCacheSizeText, Mode=OneWay}" />
                            <Button x:Uid="FilesInputsOpenButton" Command="{x:Bind Files.OpenInputsFolderCommand}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="FilesLogsLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Files.LogsFolderPath}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            <Button x:Uid="FilesLogsOpenButton" Command="{x:Bind Files.OpenLogsFolderCommand}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Files.FilesStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Spacing="4">
                            <CheckBox x:Uid="OpenWithBox" IsChecked="{x:Bind FileAssociation.OpenWithEnabled, Mode=TwoWay}" />
                            <TextBlock x:Uid="OpenWithExplainer" TextWrapping="Wrap" Opacity="0.8" />
                            <TextBlock Text="{x:Bind FileAssociation.OpenWithStatus, Mode=OneWay}" Visibility="{x:Bind FileAssociation.HasOpenWithStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsCloudResultsHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsGroupCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SettingsCloudResultsExplainer" TextWrapping="Wrap" />
                        <ComboBox x:Uid="CloudRetentionBox" ItemsSource="{x:Bind CloudResults.Choices}" DisplayMemberPath="Label" SelectedItem="{x:Bind CloudResults.SelectedChoice, Mode=TwoWay}" />
                        <TextBlock x:Uid="SettingsCloudResultsNote" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind CloudResults.RetentionStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsNotificationsHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsGroupCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SettingsNotificationsExplainer" TextWrapping="Wrap" />
                        <CheckBox x:Uid="NotifyWhenDoneBox" IsChecked="{x:Bind Notifications.NotifyWhenDone, Mode=TwoWay}" />
                        <CheckBox x:Uid="OpenFolderWhenDoneBox" IsChecked="{x:Bind Notifications.OpenFolderWhenDone, Mode=TwoWay}" />
                        <CheckBox x:Uid="OpenResultsWhenDoneBox" IsChecked="{x:Bind Notifications.OpenResultsWhenDone, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind Notifications.NotificationsStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsHelpHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsGroupCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SettingsHelpExplainer" TextWrapping="Wrap" />
                        <Button x:Uid="ReplayTourButton" Command="{x:Bind Tour.StartCommand}" />
                        <HyperlinkButton x:Uid="OpenUserGuideLink" NavigateUri="{x:Bind Tour.GuideIndexUri}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsThisPcHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsGroupCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SettingsThisPcExplainer" TextWrapping="Wrap" />
                        <!-- Where to run (issues #120, #173). A choice that cannot work right now is greyed out and the reason is the line under the box. -->
                        <StackPanel Spacing="4">
                            <ComboBox x:Uid="RunTargetBox" ItemsSource="{x:Bind ThisPc.Picker.Options}" SelectedValuePath="Value" SelectedValue="{x:Bind ThisPc.Picker.SelectedTarget, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RunTargetOption">
                                        <!-- A choice that cannot work right now reads greyed out; the reason is the line under the box. Picking it is refused by RunTargetPickerViewModel (a {Binding} on the row's IsEnabled is not used: check_app_wiring cannot see the item type). -->
                                        <ContentControl Content="{x:Bind Label}" IsEnabled="{x:Bind IsAvailable, Mode=OneWay}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{x:Bind ThisPc.Picker.ThisPcReason, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ThisPc.Picker.Note, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{x:Bind ThisPc.Picker.SaveStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <!-- The health card. -->
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="ThisPcHealthHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ThisPc.GpuText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ThisPc.DiskText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ThisPc.EngineText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ThisPc.BlockersText, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Uid="ThisPcRefreshButton" Command="{x:Bind ThisPc.RefreshCommand}" />
                            <Button x:Uid="ThisPcInstallButton" Command="{x:Bind ThisPc.InstallCommand}" />
                            <Button x:Uid="ThisPcRepairButton" Command="{x:Bind ThisPc.RepairCommand}" />
                            <Button x:Uid="ThisPcRemoveButton" Command="{x:Bind ThisPc.RemoveCommand}" />
                            <Button x:Uid="ThisPcCancelButton" Command="{x:Bind ThisPc.CancelInstallCommand}" />
                            <ProgressRing IsActive="{x:Bind ThisPc.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ThisPc.ProgressText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ThisPc.StatusText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsDiagnosticsHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsGroupCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SettingsDiagnosticsExplainer" TextWrapping="Wrap" />
                        <!-- Issue #141: off unless ticked; it unticks itself after each saved file. -->
                        <CheckBox x:Uid="DiagnosticsIncludeNotesBox" IsChecked="{x:Bind ViewModel.IncludeNotesAndTags, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Uid="SaveDiagnosticsButton" Command="{x:Bind ViewModel.SaveDiagnosticsCommand}" />
                            <Button x:Uid="DiagnosticsOpenFolderButton" Command="{x:Bind ViewModel.OpenDiagnosticsFolderCommand}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsSavingDiagnostics, Mode=OneWay}" Width="20" Height="20" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.DiagnosticsStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsAboutHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsGroupCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind Updates.CurrentVersionText}" />
                        <TextBlock Text="{x:Bind Updates.BuildText}" Opacity="0.8" IsTextSelectionEnabled="True" />
                        <RadioButtons x:Uid="UpdateChannelChoices" MaxColumns="1" SelectedIndex="{x:Bind Updates.ChannelIndex, Mode=TwoWay}">
                            <RadioButton x:Uid="UpdateChannelStable" />
                            <RadioButton x:Uid="UpdateChannelBeta" />
                        </RadioButtons>
                        <CheckBox x:Uid="UpdateCheckOnLaunchBox" IsChecked="{x:Bind Updates.CheckOnLaunch, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Uid="UpdateCheckNowButton" Command="{x:Bind Updates.CheckNowCommand}" />
                            <Button x:Uid="UpdateRestartButton" Command="{x:Bind Updates.RestartToUpdateCommand}" />
                            <ProgressRing IsActive="{x:Bind Updates.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Updates.StatusText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Spacing="4" Visibility="{x:Bind converters:VisibilityHelper.FromBool(Updates.HasUpdate), Mode=OneWay}">
                            <TextBlock x:Uid="UpdateNotesHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Updates.ReleaseNotes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsAdvancedHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <!-- Collapsed by default: these are for developers and for a clean start. -->
                <Expander x:Uid="SettingsAdvancedExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="AdvancedWorkerImageExplainer" TextWrapping="Wrap" />
                            <TextBox x:Uid="AdvancedWorkerImageBox" Text="{x:Bind Advanced.WorkerImage, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.IsDeveloperMode, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Advanced.WorkerImageStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Advanced.FakeCloudText}" TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <Button x:Uid="AdvancedResetButton" Command="{x:Bind Advanced.ResetAllSettingsCommand}" />
                            <TextBlock Text="{x:Bind Advanced.ResetStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
                <!-- Issue #239: the one proxy policy every network client follows. Collapsed by default; Windows' own settings are the right answer for most labs. -->
                <Expander x:Uid="SettingsProxyExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="ProxyExplainer" TextWrapping="Wrap" />
                        <ComboBox x:Uid="ProxyModeBox" SelectedIndex="{x:Bind Proxy.SelectedModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                            <ComboBoxItem x:Uid="ProxyModeSystemItem" />
                            <ComboBoxItem x:Uid="ProxyModeManualItem" />
                            <ComboBoxItem x:Uid="ProxyModeNoneItem" />
                        </ComboBox>
                        <StackPanel Spacing="8">
                            <TextBox x:Uid="ProxyAddressBox" Text="{x:Bind Proxy.ManualAddress, Mode=TwoWay}" IsEnabled="{x:Bind Proxy.IsManual, Mode=OneWay}" />
                            <TextBox x:Uid="ProxyUserNameBox" Text="{x:Bind Proxy.ProxyUserName, Mode=TwoWay}" IsEnabled="{x:Bind Proxy.IsManual, Mode=OneWay}" />
                            <PasswordBox x:Uid="ProxyPasswordBox" Password="{x:Bind Proxy.ProxyPassword, Mode=TwoWay}" IsEnabled="{x:Bind Proxy.IsManual, Mode=OneWay}" />
                            <TextBlock x:Uid="ProxySignInSaved" Visibility="{x:Bind Proxy.HasSavedSignIn, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Uid="ProxyApplyButton" Command="{x:Bind Proxy.ApplyCommand}" />
                        <TextBlock Text="{x:Bind Proxy.Status, Mode=OneWay}" Visibility="{x:Bind Proxy.HasStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Expander>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsViewersHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsGroupCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="SettingsViewersExplainer" TextWrapping="Wrap" />
                        <!-- Each value saves when the box loses focus or Browse picks a file, under the Viewer.* keys the Results page reads at each press. -->
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="ViewerIgvPathBox" Text="{x:Bind ExternalViewers.IgvPath, Mode=TwoWay}" />
                                <Button Grid.Column="1" x:Uid="ViewerIgvBrowseButton" VerticalAlignment="Bottom" Command="{x:Bind ExternalViewers.BrowseIgvCommand}" />
                                <Button Grid.Column="2" x:Uid="ViewerIgvPathResetButton" VerticalAlignment="Bottom" Command="{x:Bind ExternalViewers.ResetIgvPathCommand}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ExternalViewers.IgvPathStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Uid="ViewerIgvPortBox" Width="160" Text="{x:Bind ExternalViewers.IgvPortText, Mode=TwoWay}" />
                                <Button x:Uid="ViewerIgvPortResetButton" VerticalAlignment="Bottom" Command="{x:Bind ExternalViewers.ResetIgvPortCommand}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ExternalViewers.IgvPortStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="ViewerGeneiousPathBox" Text="{x:Bind ExternalViewers.GeneiousPath, Mode=TwoWay}" />
                                <Button Grid.Column="1" x:Uid="ViewerGeneiousBrowseButton" VerticalAlignment="Bottom" Command="{x:Bind ExternalViewers.BrowseGeneiousCommand}" />
                                <Button Grid.Column="2" x:Uid="ViewerGeneiousPathResetButton" VerticalAlignment="Bottom" Command="{x:Bind ExternalViewers.ResetGeneiousPathCommand}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ExternalViewers.GeneiousPathStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsTransferHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsGroupCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SettingsTransferExplainer" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="SettingsTransferExportButton" Command="{x:Bind Transfer.ExportCommand}" />
                            <Button x:Uid="SettingsTransferImportButton" Command="{x:Bind Transfer.ChooseImportFileCommand}" />
                        </StackPanel>
                        <StackPanel Spacing="8" Visibility="{x:Bind converters:VisibilityHelper.FromBool(Transfer.HasPreview), Mode=OneWay}">
                            <TextBlock Text="{x:Bind Transfer.PreviewSummary, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind Transfer.Changes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingsChangeRow">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Label}" />
                                            <TextBlock Text="{x:Bind Current}" Opacity="0.7" />
                                            <TextBlock x:Uid="SettingsTransferArrow" />
                                            <TextBlock Text="{x:Bind Incoming}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="SettingsTransferApplyButton" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Transfer.ApplyImportCommand}" />
                                <Button x:Uid="SettingsTransferCancelButton" Command="{x:Bind Transfer.CancelImportCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Transfer.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPrototypeHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource SettingsGroupCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SettingsPrototypeExplainer" TextWrapping="Wrap" />
                        <Button x:Uid="SettingsPrototypeFindButton" Command="{x:Bind PrototypeImport.FindCommand}" />
                        <TextBlock Text="{x:Bind PrototypeImport.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
