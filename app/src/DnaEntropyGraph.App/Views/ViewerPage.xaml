<Page
    x:Class="DnaEntropyGraph.App.Views.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DnaEntropyGraph.App.Converters"
    xmlns:wv2="using:Microsoft.UI.Xaml.Controls">

    <!--
        Issues #72/#73: the igv.js genome viewer. Reached by NavigationService key "Viewer" with the
        run's output folder as the parameter (RunProgress "Open viewer"). The WebView2 is hosted by
        IgvViewerHost; errors (runtime missing, no sequence file, ...) come from ViewerViewModel with
        one named action: a link, or Try again.
    -->
    <Grid Padding="12">
        <StackPanel
            Spacing="8"
            Visibility="{x:Bind converters:VisibilityHelper.FromBool(ViewModel.IsErrorVisible), Mode=OneWay}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorBody, Mode=OneWay}"
                TextWrapping="Wrap" />
            <HyperlinkButton
                Content="{x:Bind ViewModel.ActionLabel, Mode=OneWay}"
                NavigateUri="{x:Bind ViewModel.ActionUri, Mode=OneWay}"
                Visibility="{x:Bind converters:VisibilityHelper.FromBool(ViewModel.HasLinkAction), Mode=OneWay}" />
            <Button
                Content="{x:Bind ViewModel.ActionLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.RetryCommand}"
                Visibility="{x:Bind converters:VisibilityHelper.FromBool(ViewModel.HasRetryAction), Mode=OneWay}" />
        </StackPanel>

        <wv2:WebView2
            x:Name="Viewer"
            Visibility="{x:Bind converters:VisibilityHelper.FromBool(ViewModel.IsViewerVisible), Mode=OneWay}" />

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind converters:VisibilityHelper.FromBool(ViewModel.IsLoading), Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock x:Uid="ViewerLoading" />
        </StackPanel>
    </Grid>
</Page>
