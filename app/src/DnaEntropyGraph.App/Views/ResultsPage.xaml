<Page
    x:Class="DnaEntropyGraph.App.Views.ResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DnaEntropyGraph.App.Controls"
    xmlns:vm="using:DnaEntropyGraph.Presentation.ViewModels">

    <!--
        Issue #102: a finished run's numbers and files. Everything is read from the run's own output folder by
        ResultsViewModel. Issue #552: the gene tables, sortable by their headings. Issue #587: Save picture (the PNG of the overview).
    -->
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsNoticeVisible, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False"
                Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Uid="ResultsShowRunsButton" Command="{x:Bind ViewModel.ShowRunsCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsActionNoticeVisible, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False"
                Message="{x:Bind ViewModel.ActionNoticeText, Mode=OneWay}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="ResultsOpenFolderButton" Command="{x:Bind ViewModel.OpenFolderCommand}" />
                <Button x:Uid="ResultsOpenInViewerButton" Command="{x:Bind ViewModel.OpenInViewerCommand}" />
                <Button x:Uid="ResultsOpenInIgvButton" Command="{x:Bind ViewModel.OpenInIgvCommand}" />
                <Button x:Uid="ResultsOpenInGeneiousButton" Command="{x:Bind ViewModel.OpenInGeneiousCommand}" />
                <Button x:Uid="ResultsExportPngButton" Command="{x:Bind ViewModel.ExportOverviewPngCommand}" />
            </StackPanel>

            <!-- Issue #118: the entropy overview strip. Shown only when the run wrote an entropy track; fills in just after the page. -->
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasOverview, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.OverviewTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:EntropyOverviewChart
                    x:Uid="ResultsOverviewChart"
                    Height="180"
                    Contig="{x:Bind ViewModel.Overview, Mode=OneWay}"
                    RangeSelectedCommand="{x:Bind ViewModel.SelectOverviewRangeCommand}" />
                <TextBlock x:Uid="ResultsOverviewSeam" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
            </StackPanel>

            <TextBlock x:Uid="ResultsStatsHeading" Style="{StaticResource SubtitleTextBlockStyle}" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsStatsNoticeVisible, Mode=OneWay}"
                Severity="Informational"
                IsClosable="False"
                Message="{x:Bind ViewModel.StatsNoticeText, Mode=OneWay}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultsStatsGroup">
                        <StackPanel Spacing="8" Margin="0,0,0,12">
                            <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind HasTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Headline}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ResultsColumnContig" Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Uid="ResultsColumnLength" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Uid="ResultsColumnMean" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Uid="ResultsColumnMin" Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Uid="ResultsColumnMax" Grid.Column="4" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Uid="ResultsColumnDirection" Grid.Column="5" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind Contigs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ResultsContigRow">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind LengthText}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind MeanText}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind MinText}" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind MaxText}" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind DirectionText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Issue #552: the gene tables (one per *.genes.tsv), each sortable by its headings. -->
            <TextBlock
                x:Uid="ResultsGenesHeading"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Visibility="{x:Bind ViewModel.HasGeneTables, Mode=OneWay}" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsGeneNoticeVisible, Mode=OneWay}"
                Severity="Informational"
                IsClosable="False"
                Message="{x:Bind ViewModel.GeneNoticeText, Mode=OneWay}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.GeneTables}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultsGeneTable">
                        <StackPanel Spacing="6" Margin="0,0,0,12">
                            <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind HasTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind SortSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="0.6*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Uid="ResultsGeneHeadContig" Grid.Column="0" Command="{x:Bind SortByCommand}" CommandParameter="contig" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
                                <Button x:Uid="ResultsGeneHeadGene" Grid.Column="1" Command="{x:Bind SortByCommand}" CommandParameter="gene" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
                                <Button x:Uid="ResultsGeneHeadBegin" Grid.Column="2" Command="{x:Bind SortByCommand}" CommandParameter="begin" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
                                <Button x:Uid="ResultsGeneHeadEnd" Grid.Column="3" Command="{x:Bind SortByCommand}" CommandParameter="end" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
                                <Button x:Uid="ResultsGeneHeadStrand" Grid.Column="4" Command="{x:Bind SortByCommand}" CommandParameter="strand" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
                                <Button x:Uid="ResultsGeneHeadLength" Grid.Column="5" Command="{x:Bind SortByCommand}" CommandParameter="length" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
                                <Button x:Uid="ResultsGeneHeadMean" Grid.Column="6" Command="{x:Bind SortByCommand}" CommandParameter="mean" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
                                <Button x:Uid="ResultsGeneHeadMin" Grid.Column="7" Command="{x:Bind SortByCommand}" CommandParameter="min" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
                                <Button x:Uid="ResultsGeneHeadMax" Grid.Column="8" Command="{x:Bind SortByCommand}" CommandParameter="max" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
                                <Button x:Uid="ResultsGeneHeadLow" Grid.Column="9" Command="{x:Bind SortByCommand}" CommandParameter="low" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GeneRowItem">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="0.6*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Contig}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind GeneId}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind BeginText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind EndText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind Strand}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind LengthText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="6" Text="{x:Bind MeanText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="7" Text="{x:Bind MinText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="8" Text="{x:Bind MaxText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="9" Text="{x:Bind LowText}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{x:Bind TruncatedNotice}" Visibility="{x:Bind IsTruncated}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                x:Uid="ResultsFilesHeading"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Files}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultsFileItem">
                        <Grid ColumnSpacing="12" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Opacity="0.7" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="ResultsFileOpenButton" Command="{x:Bind OpenCommand}" />
                                <Button x:Uid="ResultsFileShowButton" Command="{x:Bind ShowInFolderCommand}" />
                                <Button x:Uid="ResultsFileCopyButton" Command="{x:Bind CopyPathCommand}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
