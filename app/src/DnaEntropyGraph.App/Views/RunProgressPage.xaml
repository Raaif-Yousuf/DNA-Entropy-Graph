<Page
    x:Class="DnaEntropyGraph.App.Views.RunProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Issue #66: the page a biologist stares at for 6 to 20 minutes.
        Every value below is x:Bind Mode=OneWay against RunProgressViewModel,
        which is itself driven entirely by RunPhaseChangedMessage /
        RunProgressChangedMessage (never a direct VM-status read - CLAUDE.md's
        "RUNNING is not working").
    -->
    <Grid Padding="24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Uid="RunProgressStayOpenBanner"
            Grid.Row="0"
            IsOpen="{x:Bind ViewModel.IsStayOpenBannerVisible, Mode=OneWay}"
            Severity="Informational"
            IsClosable="False" />

        <TextBlock
            Grid.Row="1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{x:Bind ViewModel.StageTitle, Mode=OneWay}" />

        <TextBlock
            Grid.Row="2"
            Text="{x:Bind ViewModel.StatusDetailText, Mode=OneWay}" />

        <ProgressBar
            Grid.Row="3"
            Minimum="0"
            Maximum="1"
            Value="{x:Bind ViewModel.FractionComplete, Mode=OneWay}" />

        <ScrollViewer Grid.Row="4">
            <TextBlock
                Text="{x:Bind ViewModel.LogTailText, Mode=OneWay}"
                TextWrapping="Wrap"
                FontFamily="Consolas" />
        </ScrollViewer>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
            <Button x:Uid="RunProgressCancel" Command="{x:Bind ViewModel.CancelCommand}" />
            <Button x:Uid="RunProgressStopVm" Command="{x:Bind ViewModel.StopVmCommand}" />
            <Button x:Uid="RunProgressDeleteVm" Command="{x:Bind ViewModel.DeleteVmCommand}" />
        </StackPanel>
    </Grid>
</Page>
