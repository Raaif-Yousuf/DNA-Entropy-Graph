<Page
    x:Class="DnaEntropyGraph.App.Views.RunProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Issue #66: the page a biologist stares at for 6 to 20 minutes.
        Every value below is x:Bind Mode=OneWay against RunProgressViewModel,
        which is itself driven entirely by RunPhaseChangedMessage /
        RunProgressChangedMessage (never a direct VM-status read - CLAUDE.md's
        "RUNNING is not working").
    -->
    <Grid Padding="24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <InfoBar
                x:Uid="RunProgressStayOpenBanner"
                IsOpen="{x:Bind ViewModel.IsStayOpenBannerVisible, Mode=OneWay}"
                Severity="Informational"
                IsClosable="False" />
            <!-- Issue #675: "taking longer than usual" / "looks stuck", from the runner through RunStallCoordinator. -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasSlowNotice, Mode=OneWay}"
                Message="{x:Bind ViewModel.SlowNoticeText, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False" />
            <!-- Issue #830: this run's Google account is signed out, so its computer cannot be stopped or deleted until the person signs in as it. -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasSignInPrompt, Mode=OneWay}"
                Message="{x:Bind ViewModel.SignInPromptText, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False">
                <InfoBar.ActionButton>
                    <Button x:Uid="RunProgressSignIn" Command="{x:Bind ViewModel.SignInCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- Issue #830 review M5: no history row for this run, so the app cannot say where its computer is; the message names the Cloud page. -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasActionNotice, Mode=OneWay}"
                Message="{x:Bind ViewModel.ActionNoticeText, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Style="{StaticResource TitleTextBlockStyle}"
            AutomationProperties.LiveSetting="Polite"
            Text="{x:Bind ViewModel.StageTitle, Mode=OneWay}" />

        <TextBlock
            Grid.Row="2"
            AutomationProperties.LiveSetting="Polite"
            Text="{x:Bind ViewModel.StatusDetailText, Mode=OneWay}" />

        <ProgressBar
            Grid.Row="3"
            Minimum="0"
            Maximum="1"
            Value="{x:Bind ViewModel.FractionComplete, Mode=OneWay}" />

        <ScrollViewer Grid.Row="4">
            <TextBlock
                Text="{x:Bind ViewModel.LogTailText, Mode=OneWay}"
                TextWrapping="Wrap"
                FontFamily="Consolas" />
        </ScrollViewer>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
            <Button x:Uid="RunProgressCancel" Command="{x:Bind ViewModel.CancelCommand}" />
            <Button x:Uid="RunProgressStopVm" Command="{x:Bind ViewModel.StopVmCommand}" />
            <Button x:Uid="RunProgressDeleteVm" Command="{x:Bind ViewModel.DeleteVmCommand}" />
            <Button x:Uid="RunProgressOpenResults" Command="{x:Bind ViewModel.OpenResultsCommand}" />
            <Button x:Uid="RunProgressOpenViewer" Command="{x:Bind ViewModel.OpenViewerCommand}" />
        </StackPanel>
    </Grid>
</Page>
