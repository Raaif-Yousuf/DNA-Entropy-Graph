<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MEASURED 2026-09-19 (orchestrator, throwaway project outside this repo):
    an unpackaged WinUI 3 app restores, compiles its XAML (App.xbf,
    MainWindow.xbf appear in the output) and builds from the dotnet CLI
    alone, zero warnings, with exactly these properties and exactly these
    two packages. Do not change TargetFramework/TargetPlatformMinVersion/
    RuntimeIdentifier without re-measuring - see LANE_APP_BRIEF.md.
  -->
  <PropertyGroup>
    <AssemblyName>DnaEntropyGraph.App</AssemblyName>
    <RootNamespace>DnaEntropyGraph.App</RootNamespace>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <!--
      #475. SelfContained covers the .NET runtime only. MEASURED 2026-10-03: publishing without this property gave 252 files and no
      Microsoft.ui.xaml.dll (the app then needs the Windows App SDK runtime installed on the PC); with it, 441 files including
      Microsoft.ui.xaml.dll. Set here, not only as a CLI flag, so every publish path carries it; pinned by
      Guards.Tests/AppPublishPropertiesGuardTests.

      Publish only (_IsPublishing is set by `dotnet publish`). MEASURED 2026-10-03: set for every build, Guards.Tests'
      DiResolutionTests died with COMException "ClassFactory cannot supply requested class" in DispatcherAdapter, because a
      self-contained Windows App SDK drops the bootstrap auto-initializer and a test host (not this exe) has no manifest
      to activate WinUI types from. A plain build keeps the installed-runtime path the tests and `dotnet run` rely on.
    -->
    <WindowsAppSDKSelfContained Condition="'$(_IsPublishing)' == 'true'">true</WindowsAppSDKSelfContained>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DnaEntropyGraph.Presentation\DnaEntropyGraph.Presentation.csproj" />
    <ProjectReference Include="..\DnaEntropyGraph.Cloud\DnaEntropyGraph.Cloud.csproj" />
    <ProjectReference Include="..\DnaEntropyGraph.Persistence\DnaEntropyGraph.Persistence.csproj" />
    <ProjectReference Include="..\DnaEntropyGraph.LocalEngine\DnaEntropyGraph.LocalEngine.csproj" />
  </ItemGroup>

  <!-- Issue #458: the worker images pinned by digest for this app version; also the allowlist. -->
  <ItemGroup>
    <EmbeddedResource Include="worker-images.json" LogicalName="worker-images.json" />
  </ItemGroup>

  <!-- Issues #72/#73: the vendored igv.js viewer, served to WebView2 as https://viewer.deg/ from <output>\Assets\viewer. -->
  <ItemGroup>
    <Content Include="Assets\viewer\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Hard Rule 13: every user-visible string lives in
    Strings\en-US\Resources.resw, referenced via x:Uid, never inline. The
    .NET SDK includes it as a PRIResource by default from the project
    directory - an explicit <PRIResource Include> here is a duplicate-item
    build error (NETSDK1022), not a no-op.
  -->

</Project>
