<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hard Rule 7: this is the ONLY project allowed to reference Google.*.
    The only Google package so far is Google.Apis.Auth (issue #48, the OAuth sign-in);
    the real gateway implementations (GoogleAuthService, ProjectSetupService,
    VmAllocator, ...) are a follow-up issue under this epic. FakeGcp below
    is real: it is what every other test project depends on instead of a
    real Google Cloud project.
  -->
  <PropertyGroup>
    <AssemblyName>DnaEntropyGraph.Cloud</AssemblyName>
    <RootNamespace>DnaEntropyGraph.Cloud</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="Google.Apis.CloudResourceManager.v3" />
    <PackageReference Include="Google.Apis.Cloudbilling.v1" />
    <PackageReference Include="Google.Apis.ServiceUsage.v1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DnaEntropyGraph.Core\DnaEntropyGraph.Core.csproj" />
  </ItemGroup>

</Project>
