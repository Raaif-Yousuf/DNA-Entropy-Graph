<Project>
  <!--
    Common properties for every project under app/ (CLAUDE.md, issue #61).
    A project overrides any of these in its own .csproj by setting the
    property again after the SDK import evaluates this file - that is how
    DnaEntropyGraph.App gets its Windows-flavored TargetFramework instead of
    the plain net10.0 default below.
  -->
  <PropertyGroup>
    <!--
      scripts/check_version_lockstep.py (issue #33): this must always equal
      worker/pyproject.toml's [project].version exactly. That file is not
      mine to edit - if the worker version ever moves, update this one line
      to match it, never the other file.
    -->
    <Version>0.0.1</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Company>DNA Entropy Graph</Company>
    <Product>DNA Entropy Graph</Product>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Central Package Management (Directory.Packages.props) -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
</Project>
