<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- App (WinUI 3) -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.250916003" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />

    <!-- Presentation (MVVM), no WinUI reference -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- DI, used by App -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />

    <!-- Cloud: retry, jitter and circuit breaker for every gateway call (issue #258). Polly is BSD-3-Clause. -->
    <PackageVersion Include="Polly.Core" Version="8.6.5" />

    <!-- Cloud: Google OAuth for the desktop sign-in (issue #48). Apache-2.0. Only DnaEntropyGraph.Cloud references it (Hard Rule 7). -->
    <PackageVersion Include="Google.Apis.Auth" Version="1.77.0" />
    <!-- Cloud: REST discovery clients for Resource Manager v3, Cloud Billing and Service Usage (issues #50 to #52). Apache-2.0. Chosen over Google.Cloud.* because their HttpClientFactory is injectable (docs/cloud_design.md section 16). -->
    <PackageVersion Include="Google.Apis.CloudResourceManager.v3" Version="1.76.0.4277" />
    <!-- Cloud: DPAPI (CurrentUser) for the token files (issue #48). MIT. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />

    <!-- Tests: xUnit v3, Shouldly, NSubstitute (Hard Rule 21 - not FluentAssertions 8+, not Moq) -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>
</Project>
