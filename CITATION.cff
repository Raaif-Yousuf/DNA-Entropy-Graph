    title: "Genome modeling and design across all domains of life with Evo 2"
    authors:
      - family-names: "Brixi"
        given-names: "Garyk"
      # First author only; the full author list is on the paper's page at the DOI.
    year: 2025
    journal: "bioRxiv"
